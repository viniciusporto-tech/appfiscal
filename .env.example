# URL do projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública usada pelo navegador com RLS habilitado.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_COLOQUE_AQUI

# Chave secreta usada SOMENTE pelas rotas administrativas do servidor.
# Nunca use NEXT_PUBLIC_ nesta variável.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_COLOQUE_AQUI
